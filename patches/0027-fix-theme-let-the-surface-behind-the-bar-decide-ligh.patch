From: AbelDuan <32724782+AbelDuan@users.noreply.github.com>
Date: Thu, 26 Nov 2026 18:36:07 +0800
Subject: [PATCH 27/28] fix(theme): let the surface behind the bar decide light
 or dark

Weibo renders a light page while its process reports NIGHT_YES under the
system auto switch, and its labels are hidden by this module, so the
detected theme stayed null and the bar followed the system switch instead
of the page.

The probe now looks at the opaque colour painted behind the navigation
row first (the surface the glass sits on) and only falls back to label
luminance when no surface colour is visible.
---
 .../offlineglass/hook/GlassHostLayout.kt      | 44 ++++++++++++++++++-
 1 file changed, 43 insertions(+), 1 deletion(-)

diff --git a/app/src/main/java/io/github/offlineglass/hook/GlassHostLayout.kt b/app/src/main/java/io/github/offlineglass/hook/GlassHostLayout.kt
index 4cfb9fe..c501b42 100644
--- a/app/src/main/java/io/github/offlineglass/hook/GlassHostLayout.kt
+++ b/app/src/main/java/io/github/offlineglass/hook/GlassHostLayout.kt
@@ -13593,7 +13593,46 @@ internal fun surfaceContainerColor(dark: Boolean): Int {
 
         }
 
-        if (luminances.isNotEmpty()) {
+        // Labels are only one signal. A bar the module redraws itself hides its own
+        // labels, so an adapter that reports no text (Weibo) never resolved, and the
+        // decision fell through to the system-wide night switch. An opaque colour
+        // drawn behind the row is the surface the glass sits on, so it decides first.
+        val surfaces = ArrayList<Float>(4)
+
+        var surfaceView: View? = source
+
+        var surfaceDepth = 0
+
+        while (surfaceView != null && surfaceDepth < 4) {
+
+            val background = surfaceView.background
+
+            val painted = when (background) {
+                is android.graphics.drawable.ColorDrawable -> background.color
+                else -> null
+            }
+
+            if (painted != null && Color.alpha(painted) >= 200) {
+
+                surfaces += 0.2126f * Color.red(painted) +
+                    0.7152f * Color.green(painted) +
+                    0.0722f * Color.blue(painted)
+
+            }
+
+            surfaceView = surfaceView.parent as? View
+
+            surfaceDepth++
+
+        }
+
+        if (surfaces.isNotEmpty()) {
+
+            surfaces.sort()
+
+            detectedContentDark = surfaces[surfaces.size / 2] < DARK_SURFACE_LUMINANCE
+
+        } else if (luminances.isNotEmpty()) {
 
             luminances.sort()
 
@@ -14359,6 +14398,9 @@ internal fun isDarkGlass(): Boolean {
 
         const val DARK_LABEL_LUMINANCE = 145f
 
+        /** An opaque surface darker than this reads as a dark-mode page. */
+        const val DARK_SURFACE_LUMINANCE = 96f
+
         // QQ's drawer/page layers animate independently while remaining
 
         // attached. Probe once per display frame so the home bar begins its
