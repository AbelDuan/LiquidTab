diff --git a/app/src/main/java/io/github/offlineglass/hook/GlassHostLayout.kt b/app/src/main/java/io/github/offlineglass/hook/GlassHostLayout.kt
index 8ab792a..f08165d 100644
--- a/app/src/main/java/io/github/offlineglass/hook/GlassHostLayout.kt
+++ b/app/src/main/java/io/github/offlineglass/hook/GlassHostLayout.kt
@@ -7831,11 +7831,19 @@ internal fun syncOpticalVisibilityCompanions() {
 
         index in 0 until slotCount &&
 
-            (config.hiddenMask and (1 shl index) != 0 || targetAdapter?.isNavigationEntryDisabled(index, slotCount) == true ||
+            (hiddenMaskForSlots() and (1 shl index) != 0 || targetAdapter?.isNavigationEntryDisabled(index, slotCount) == true ||
                 appNavigationState?.isNavigationEntryAvailable(index) == false)
 
 
 
+    /** Adapters may re-map a persisted mask when the native row lost or gained a slot. */
+
+    private fun hiddenMaskForSlots(): Int =
+
+        targetAdapter?.navigationHiddenMask(config.hiddenMask, slotCount) ?: config.hiddenMask
+
+
+
     private fun enabledNavigationIndices(): List<Int> =
 
         (adapterBarLayout()?.navigationIndices ?: (0 until slotCount).toList()).filterNot(::isNavigationEntryDisabled)
