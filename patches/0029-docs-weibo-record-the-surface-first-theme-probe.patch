+++++diff --git a/app/src/main/java/io/github/offlineglass/hook/adapters/xhs/XhsSearchChrome.kt b/app/src/main/java/io/github/offlineglass/hook/adapters/xhs/XhsSearchChrome.kt
+++++new file mode 100644
