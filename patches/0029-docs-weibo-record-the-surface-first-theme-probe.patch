+++++diff --git a/.github/workflows/build-apk.yml b/.github/workflows/build-apk.yml
+++++new file mode 100644
+++++index 0000000..b90826e
+++++--- /dev/null
++++++++ b/.github/workflows/build-apk.yml
+++++@@ -0,0 +1,109 @@
++++++name: build-apk
++++++
++++++# 只在自定义生产分支和自定义发布标签上跑，避免上游同步提交触发重复构建。
++++++on:
++++++  push:
++++++    branches: [custom]
++++++    tags: ['custom-v*']
++++++  workflow_dispatch:
++++++
++++++permissions:
++++++  contents: write
++++++
++++++concurrency:
++++++  group: build-${{ github.ref }}
++++++  cancel-in-progress: true
++++++
++++++jobs:
++++++  build:
++++++    runs-on: ubuntu-latest
++++++    timeout-minutes: 45
++++++    steps:
++++++      - uses: actions/checkout@v4
++++++
++++++      - name: Set up JDK 21
++++++        uses: actions/setup-java@v4
++++++        with:
++++++          distribution: temurin
++++++          java-version: '21'
++++++
++++++      - name: Set up Android SDK
++++++        uses: android-actions/setup-android@v3
++++++
++++++      - name: Install platform 37 and build tools
++++++        run: |
++++++          yes | sdkmanager --licenses >/dev/null || true
++++++          sdkmanager --channel=3 "platforms;android-37" "build-tools;37.0.0"
++++++
++++++      - name: Set up Gradle
++++++        uses: gradle/actions/setup-gradle@v4
++++++
++++++      - name: Read version
++++++        id: version
++++++        run: |
++++++          NAME=$(grep -oP 'versionName\s*=\s*"\K[^"]+' app/build.gradle.kts | head -1)
++++++          CODE=$(grep -oP 'versionCode\s*=\s*\K[0-9]+' app/build.gradle.kts | head -1)
++++++          echo "name=$NAME" >> "$GITHUB_OUTPUT"
++++++          echo "code=$CODE" >> "$GITHUB_OUTPUT"
++++++
++++++      - name: Assemble release
++++++        run: ./gradlew :app:assembleRelease --no-daemon --stacktrace
++++++
++++++      - name: Sign APK
++++++        if: ${{ secrets.KEYSTORE_B64 != '' }}
++++++        env:
++++++          KEYSTORE_B64: ${{ secrets.KEYSTORE_B64 }}
++++++          KEYSTORE_PASSWORD: ${{ secrets.KEYSTORE_PASSWORD }}
++++++          KEY_ALIAS: ${{ secrets.KEY_ALIAS }}
++++++          KEY_PASSWORD: ${{ secrets.KEY_PASSWORD }}
++++++          VERSION_NAME: ${{ steps.version.outputs.name }}
++++++          VERSION_CODE: ${{ steps.version.outputs.code }}
++++++        run: |
++++++          set -euo pipefail
++++++          echo "$KEYSTORE_B64" | base64 -d > "$RUNNER_TEMP/liquidtab.keystore"
++++++          BT=$(ls "$ANDROID_HOME/build-tools" | sort -V | tail -1)
++++++          APKSIGNER="$ANDROID_HOME/build-tools/$BT/apksigner"
++++++          SRC=$(find app/build/outputs/apk/release -name '*-unsigned.apk' | head -1)
++++++          test -n "$SRC"
++++++          OUT="LiquidTab-${VERSION_NAME}-${VERSION_CODE}-custom.apk"
++++++          "$APKSIGNER" sign \
++++++            --ks "$RUNNER_TEMP/liquidtab.keystore" \
++++++            --ks-key-alias "$KEY_ALIAS" \
++++++            --ks-pass env:KEYSTORE_PASSWORD \
++++++            --key-pass env:KEY_PASSWORD \
++++++            --out "$OUT" "$SRC"
++++++          "$APKSIGNER" verify --print-certs "$OUT"
++++++          sha256sum "$OUT" > "$OUT.sha256"
++++++          cat "$OUT.sha256"
++++++
++++++      - name: Fallback unsigned APK
++++++        if: ${{ secrets.KEYSTORE_B64 == '' }}
++++++        run: |
++++++          set -euo pipefail
++++++          SRC=$(find app/build/outputs/apk/release -name '*-unsigned.apk' | head -1)
++++++          test -n "$SRC"
++++++          cp "$SRC" "LiquidTab-${{ steps.version.outputs.name }}-${{ steps.version.outputs.code }}-unsigned.apk"
++++++          sha256sum LiquidTab-*.apk > SHA256SUMS.txt
++++++          cat SHA256SUMS.txt
++++++
++++++      - name: Upload workflow artifact
++++++        uses: actions/upload-artifact@v4
++++++        with:
++++++          name: LiquidTab-${{ steps.version.outputs.name }}-${{ steps.version.outputs.code }}
++++++          path: |
++++++            LiquidTab-*.apk
++++++            LiquidTab-*.apk.sha256
++++++            SHA256SUMS.txt
++++++          if-no-files-found: error
++++++
++++++      - name: Publish GitHub release
++++++        if: startsWith(github.ref, 'refs/tags/custom-v')
++++++        uses: softprops/action-gh-release@v2
++++++        with:
++++++          files: |
++++++            LiquidTab-*.apk
++++++            LiquidTab-*.apk.sha256
++++++          generate_release_notes: true
++++++          body: |
++++++            基于上游 tag `${{ github.event.repository.description }}` 的自定义构建。
++++++            安装前请确认设备允许跨签名覆盖安装，或先备份数据。
+++++diff --git a/fork/ADAPTING.md b/fork/ADAPTING.md
+++++new file mode 100644
+++++index 0000000..cc56eaf
+++++--- /dev/null
++++++++ b/fork/ADAPTING.md
+++++@@ -0,0 +1,93 @@
++++++# 新应用版本适配手册
++++++
++++++目标：应用改版、上游 LiquidTab 还没更新时，我们能在本 fork 里独立适配，并且下次上游更新时补丁仍然容易搬。
++++++
++++++## 0. 先判断问题属于哪一层
++++++
++++++| 现象 | 优先看 |
++++++| --- | --- |
++++++| 整个底栏/顶栏不出现、错位 | 导航发现、Hook 信号、安装器 |
++++++| 原生控件没被替换干净（多一个框、多一行字） | 对应应用的 `*TopBar` / `*Chrome` / `*Adapter` |
++++++| 替换后点不动、点错页 | 点击源（`performClick` 目标）和页面状态 |
++++++| 只有某个子页面异常 | 应用目录里的页面例外/视口代码 |
++++++
++++++先看应用目录，不要一上来改共享 `GlassHostLayout`。
++++++
++++++## 1. 抓现场（必须做）
++++++
++++++在目标页面停留，然后任选其一：
++++++
++++++```bash
++++++# 当前 Activity + 视图树（最有用）
++++++adb shell dumpsys activity top | head -200
++++++
++++++# 可交互元素的 resource-id / text / bounds
++++++adb shell uiautomator dump /sdcard/window_dump.xml
++++++adb pull /sdcard/window_dump.xml
++++++
++++++# 看模块自己的日志
++++++adb logcat -s LiquidTabXhsTop LiquidTabDouyin OfflineGlass
++++++```
++++++
++++++有 APK 时，直接看布局比在设备上猜更快：`resources.arsc` 里布局名可能被混淆（小红书是 `r/*.xml`），按资源 ID 的 4 字节小端在 `res/layout*.xml` 或 `r/*.xml` 里搜，再用 AXML 解码器打印层级。
++++++
++++++## 2. 找“结构锚点”，不要记版本号
++++++
++++++上游约定（必须遵守）：
++++++
++++++- 类名/控件层级优先，`R.id` 数值只作提示；
++++++- 不写 `if (versionName == ...)`；
++++++- 找不到就保留原生界面并打日志，不猜、不隐藏整页。
++++++
++++++小红书的例子（9.50）：
++++++
++++++- 顶栏容器：`FrameLayout`，内含 `HomeTabLayout`（tabs）和搜索层；
++++++- 搜索图标：`ImageView`，父层是搜索条的 `ConstraintLayout`；
++++++- 残留“搜索提示框”：与图标同层的 `TextView`（带 background，文字是搜索提示）；
++++++- 只隐藏图标，不隐藏同层文字，就会剩下一个背景框。
++++++
++++++## 3. 改在正确的那一层
++++++
++++++- 应用专属逻辑只放在 `app/src/main/java/io/github/offlineglass/hook/adapters/<key>/`；
++++++- 隐藏原生控件统一走该应用 Session 的 `hide(...)`（记录原始 alpha/visibility，退出时恢复），不要直接 `setVisibility(GONE)`；
++++++- 要保留点击能力时只把 `alpha` 设为 0，不要设 `INVISIBLE`/`GONE`；
++++++- 新增隐藏逻辑要能处理“控件晚到”：在现有 `onPreDraw`/`scan()` 节流里执行，不要另起无限循环。
++++++
++++++## 4. 本地验证
++++++
++++++```bash
++++++./gradlew :app:assembleRelease
++++++```
++++++
++++++装到设备后：
++++++
++++++1. 打开目标应用首页，确认没有多余框/字；
++++++2. 点我们自己的按钮，确认走的是原生逻辑；
++++++3. 切到二级页再返回，确认没有恢复一半；
++++++4. 深色/浅色、折叠/展开各看一次；
++++++5. `adb logcat` 里没有 `LiquidTab<App>` 的契约拒绝日志。
++++++
++++++编译通过不等于运行时通过，必须写清“在哪个应用版本、哪个页面”实测过。
++++++
++++++## 5. 提交与出包
++++++
++++++```bash
++++++git switch custom
++++++git add -A
++++++git commit -m "fix(xhs): hide native search hint layer beside the glass search key"
++++++git push origin custom
++++++```
++++++
++++++CI 自动出 APK。确认没问题再打标签：
++++++
++++++```bash
++++++git tag custom-v2.1.2.1
++++++git push origin custom-v2.1.2.1
++++++```
++++++
++++++## 6. 让补丁容易搬回上游
++++++
++++++- 一个应用一个提交，提交信息写 `fix(<key>): ...` / `feat(<key>): ...`；
++++++- 不改上游的版本号、签名配置、README（除非必要）；
++++++- 共享文件只做最小改动，并在提交说明里写“为什么必须改共享层”；
++++++- 每次同步上游后跑一遍 `tools/export-patches.sh`，把补丁留在 `patches/` 里，冲突时可直接 `git apply` 对照。
