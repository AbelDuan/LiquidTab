diff --git a/.github/workflows/watch-upstream.yml b/.github/workflows/watch-upstream.yml
new file mode 100644
index 0000000..7e0fba0
--- /dev/null
+++ b/.github/workflows/watch-upstream.yml
@@ -0,0 +1,61 @@
+name: watch-upstream
+
+# 每天检查上游是否发了新版本；有就开一个 issue 提醒同步。
+on:
+  schedule:
+    - cron: '0 20 * * *'   # 04:00 Asia/Shanghai
+  workflow_dispatch:
+
+permissions:
+  contents: read
+  issues: write
+
+jobs:
+  check:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          ref: custom
+
+      - name: Compare upstream release with fork base
+        uses: actions/github-script@v7
+        with:
+          script: |
+            const fs = require('fs');
+            const base = fs.readFileSync('fork/upstream-base', 'utf8').trim();
+            const upstream = await github.rest.repos.getLatestRelease({
+              owner: 'big-dictator', repo: 'LiquidTab'
+            }).catch(() => null);
+            if (!upstream) {
+              core.info('上游还没有 release，跳过');
+              return;
+            }
+            const latest = upstream.data.tag_name;
+            core.info(`fork base=${base}, upstream latest=${latest}`);
+            if (latest === base) return;
+
+            const title = `上游有新版本 ${latest}（当前基线 ${base}）`;
+            const open = await github.rest.issues.listForRepo({
+              owner: context.repo.owner, repo: context.repo.repo,
+              state: 'open', per_page: 100
+            });
+            if (open.data.some(i => i.title === title)) return;
+
+            await github.rest.issues.create({
+              owner: context.repo.owner, repo: context.repo.repo,
+              title,
+              body: [
+                `上游 [LiquidTab](${upstream.data.html_url}) 发布了 \`${latest}\`。`,
+                '',
+                '同步步骤：',
+                '',
+                '```bash',
+                'git fetch upstream --tags',
+                `tools/sync-upstream.sh ${latest}`,
+                'git push origin custom --follow-tags',
+                '```',
+                '',
+                '冲突处理见 `fork/README.md` 和 `fork/ADAPTING.md`。'
+              ].join('\n')
+            });
diff --git a/fork/README.md b/fork/README.md
index ef88709..0ca7df3 100644
--- a/fork/README.md
+++ b/fork/README.md
@@ -48,6 +48,12 @@ tools/export-patches.sh        # 导出到 patches/
 
 ## 出包
 
+首次在新环境启用：
+
+1. 在仓库 Settings → Secrets and variables → Actions 配置 `KEYSTORE_B64`、`KEYSTORE_PASSWORD`、`KEY_ALIAS`、`KEY_PASSWORD`；
+2. 在 Actions 里启用 workflow（fork 默认是关的）；
+3. 推送 `custom` 或手动运行 `build-apk`。
+
 推送到 `custom` 或手动 `workflow_dispatch` 即构建：
 
 - 有 `KEYSTORE_B64` 等 secrets：直接产出已签名 APK + SHA256；
